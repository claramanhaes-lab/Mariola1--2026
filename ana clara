const express = require('express')
const app = express()
app.use(express.urlencoded({ extended: true }))

app.get('/', (request, response) => {
response.send('Envie os parâmetros n1 e n2 para as rotas matemáticas')
})

// Rota de soma
app.get('/soma', (req, res) => {
let result = parseFloat(req.query.n1) + parseFloat(req.query.n2)

if (isNaN(result)) {
result = "Valores inválidos."
} else {
result = `${req.query.n1} + ${req.query.n2} = ${result}`
}

res.send({ conta: result })
})

// Rota de subtração
app.get('/subtracao', (req, res) => {
let result = parseFloat(req.query.n1) - parseFloat(req.query.n2)

if (isNaN(result)) {
result = "Valores inválidos."
} else {
result = `${req.query.n1} - ${req.query.n2} = ${result}`
}

res.send({ conta: result })
})

// Rota de multiplicação
app.get('/multiplicacao', (req, res) => {
let result = parseFloat(req.query.n1) * parseFloat(req.query.n2)

if (isNaN(result)) {
result = "Valores inválidos."
} else {
result = `${req.query.n1} * ${req.query.n2} = ${result}`
}

res.send({ conta: result })
})

// Rota de divisão
app.get('/divisao', (req, res) => {
let n1 = parseFloat(req.query.n1)
let n2 = parseFloat(req.query.n2)

if (isNaN(n1) || isNaN(n2)) {
result = "Valores inválidos."
} else if (n2 === 0) {
result = "Erro: não é possível dividir por zero."
} else {
result = `${n1} / ${n2} = ${n1 / n2}`
}

res.send({ conta: result })
})
